#2.Create a function called get_delivery_charge(amount, city='Ahmedabad')
#  that returns 0 if city is 'Ahmedabad', otherwise returns 50 as a delivery charge.
# Hint:Use a default argument for the city parameter.

def get_delivery_charge(amount, city='Ahmedabad'):
    if city == "Ahmedabad":
        return 0 
    else:
        return 50
amount = float(input("Enter the amount:"))
city = input("Enter the city:")


if city == "":
    print("Delivery Charge:", get_delivery_charge(amount))
else:
    print("Delivery Charge:", get_delivery_charge(amount, city))

